{
  "name": "traingrid",
  "version": "0.2.0-beta",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase db start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > lib/database.types.ts",
    "supabase:start": "supabase start -x studio,imgproxy,logflare,vector,supavisor,postgres-meta,mailpit",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:generate": "tsx scripts/generate-global-seed.ts",
    "import:legacy": "tsx scripts/import-legacy-schedule.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run db:test && npm run test:integration && npm run test:e2e && npm run build",
    "scan:secrets": "tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
